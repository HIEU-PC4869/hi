      <!-- SCREEN 0: LOGIN -->
      <widget class="QWidget" name="page_login">
       <layout class="QVBoxLayout" name="loginLayout">
        <item>
         <spacer name="loginSpacerTop">
          <property name="orientation">
           <enum>Qt::Vertical</enum>
          </property>
         </spacer>
        </item>
        <item alignment="Qt::AlignCenter">
         <widget class="QFrame" name="frame_login_card">
          <property name="minimumSize">
           <size>
            <width>420</width>
            <height>460</height>
           </size>
          </property>
          <layout class="QVBoxLayout" name="cardLayout">
           <property name="spacing">
