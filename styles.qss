/* Glacier Glassmorphism Theme for PySide6 / Qt */
QWidget {
    background-color: #0a0e1a;
    color: #e0e8f0;
    font-family: 'Segoe UI', 'Inter', -apple-system, sans-serif;
    font-size: 13px;
}

QMainWindow, QStackedWidget {
    background-color: #0a0e1a;
}

/* Header & Sidebar frames */
QFrame#frame_top_header {
    background-color: rgba(15, 21, 36, 0.85);
    border-bottom: 1px solid rgba(125, 211, 252, 0.15);
}

QFrame#frame_sidebar {
    background-color: rgba(17, 24, 40, 0.75);
    border-right: 1px solid rgba(125, 211, 252, 0.12);
}

QFrame#frame_banner, QFrame#frame_card, QGroupBox {
    background-color: rgba(20, 28, 46, 0.7);
    border: 1px solid rgba(125, 211, 252, 0.15);
    border-radius: 14px;
    padding: 12px;
}

QGroupBox {
    margin-top: 14px;
    font-weight: bold;
    color: #e0e8f0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 6px;
    color: #7dd3fc;
    font-size: 13px;
}

/* PushButtons */
QPushButton {
    background-color: rgba(26, 36, 56, 0.8);
    color: #e0e8f0;
    border: 1px solid rgba(125, 211, 252, 0.2);
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: rgba(32, 44, 66, 0.95);
    border-color: rgba(125, 211, 252, 0.45);
}

QPushButton:pressed {
    background-color: #0e4d6e;
}

/* Primary Accent Buttons (Ice-Blue) */
QPushButton#btn_login, QPushButton#btn_submit_attendance, QPushButton#btn_save_notes, QPushButton#btn_start_session, QPushButton#btn_add_user {
    background-color: #7dd3fc;
    color: #001f2e;
    border: 1px solid #7dd3fc;
    font-weight: bold;
    border-radius: 10px;
    padding: 10px 18px;
}

QPushButton#btn_login:hover, QPushButton#btn_submit_attendance:hover, QPushButton#btn_save_notes:hover, QPushButton#btn_start_session:hover, QPushButton#btn_add_user:hover {
    background-color: #c8eaff;
    border-color: #c8eaff;
}

/* Tertiary Buttons (Lavender) */
QPushButton#btn_submit_excuse, QPushButton#btn_approve_excuse {
    background-color: #c8a0f0;
    color: #1a002e;
    border: 1px solid #c8a0f0;
    font-weight: bold;
    border-radius: 10px;
    padding: 9px 16px;
}

QPushButton#btn_submit_excuse:hover, QPushButton#btn_approve_excuse:hover {
    background-color: #e8d0ff;
}

/* Error / Reject Buttons */
QPushButton#btn_end_session, QPushButton#btn_reject_excuse {
    background-color: rgba(61, 20, 20, 0.85);
    color: #ffb3b3;
    border: 1px solid rgba(255, 107, 107, 0.4);
    font-weight: bold;
    border-radius: 10px;
    padding: 9px 16px;
}

QPushButton#btn_end_session:hover, QPushButton#btn_reject_excuse:hover {
    background-color: #5c1e1e;
    border-color: #ff6b6b;
}

/* Top Nav Pill Buttons */
QPushButton[class="nav-tab"] {
    background-color: transparent;
    border: none;
    color: #a0b4c4;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 12px;
}

QPushButton[class="nav-tab"]:hover {
    background-color: rgba(26, 36, 56, 0.7);
    color: #e0e8f0;
}

QPushButton[class="nav-tab-active"] {
    background-color: #0e4d6e;
    color: #c8eaff;
    font-weight: bold;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
}

/* Sidebar Navigation Items */
QPushButton[class="side-nav"] {
    background-color: transparent;
    border: none;
    color: #a0b4c4;
    text-align: left;
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton[class="side-nav"]:hover {
    background-color: rgba(26, 36, 56, 0.6);
    color: #e0e8f0;
}

QPushButton[class="side-nav-active"] {
    background-color: #0e4d6e;
    color: #c8eaff;
    border: none;
    text-align: left;
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: bold;
}

/* Inputs & Form Fields */
QLineEdit, QTextEdit, QDateEdit, QComboBox {
    background-color: rgba(26, 36, 56, 0.75);
    border: 1px solid rgba(125, 211, 252, 0.18);
    border-radius: 9px;
    padding: 8px 12px;
    color: #e0e8f0;
    selection-background-color: #0e4d6e;
    selection-color: #c8eaff;
}

QLineEdit:focus, QTextEdit:focus, QDateEdit:focus, QComboBox:focus {
    border: 1px solid #7dd3fc;
    background-color: rgba(26, 36, 56, 0.95);
}

/* Dropdown ComboBox styling */
QComboBox {
    padding-right: 24px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: none;
}

QComboBox QAbstractItemView {
    background-color: #141c2e;
    border: 1px solid rgba(125, 211, 252, 0.25);
    border-radius: 8px;
    color: #e0e8f0;
    selection-background-color: #0e4d6e;
    selection-color: #c8eaff;
    padding: 4px;
}

/* QTableWidget Modern Glassmorphism Styling */
QTableWidget {
    background-color: rgba(17, 24, 40, 0.7);
    border: 1px solid rgba(125, 211, 252, 0.15);
    border-radius: 14px;
    gridline-color: transparent;
    selection-background-color: rgba(14, 77, 110, 0.5);
    selection-color: #c8eaff;
    outline: none;
}

QTableWidget::item {
    padding: 8px 10px;
    border-bottom: 1px solid rgba(125, 211, 252, 0.06);
}

QTableWidget::item:selected {
    background-color: rgba(14, 77, 110, 0.6);
    color: #c8eaff;
}

QHeaderView::section {
    background-color: rgba(26, 36, 56, 0.85);
    color: #a0b4c4;
    padding: 10px;
    font-size: 11px;
    font-weight: bold;
    border: none;
    border-bottom: 1px solid rgba(125, 211, 252, 0.18);
    text-transform: uppercase;
}

QHeaderView::section:first {
    border-top-left-radius: 12px;
}

QHeaderView::section:last {
    border-top-right-radius: 12px;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: rgba(10, 14, 26, 0.5);
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(74, 96, 112, 0.5);
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(125, 211, 252, 0.6);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Labels */
QLabel {
    background: transparent;
}

QLabel#lbl_dynamic_qr {
    color: #7dd3fc;
    font-size: 26px;
    font-weight: bold;
    font-family: 'Consolas', 'Courier New', monospace;
}

QLabel#lbl_timer {
    color: #c8a0f0;
    font-size: 22px;
    font-weight: bold;
    font-family: 'Consolas', 'Courier New', monospace;
}

QLabel#lbl_checkin_status {
    background-color: rgba(14, 77, 110, 0.5);
    color: #7dd3fc;
    border: 1px solid rgba(125, 211, 252, 0.3);
    border-radius: 12px;
    padding: 6px 14px;
    font-weight: 600;
}
