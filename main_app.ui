      <!-- SCREEN 1: STUDENT MODULE -->
      <widget class="QWidget" name="page_student">
       <layout class="QVBoxLayout" name="studentLayout">
        <property name="margin">
         <number>20</number>
        </property>
        <property name="spacing">
         <number>16</number>
        </property>
        <item>
         <widget class="QLabel" name="lbl_student_header">
          <property name="text">
           <string>&lt;h2&gt;Student Attendance &amp; Compliance Dashboard&lt;/h2&gt;</string>
          </property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="studentTopRow">
          <!-- Direct Check-in Box -->
          <item>
           <widget class="QGroupBox" name="grp_checkin">
            <property name="title">
             <string>Fast Check-In (QR / Session PIN)</string>
            </property>
            <layout class="QVBoxLayout" name="checkinSubLayout">
             <item>
              <widget class="QLabel" name="lbl_select_course">
               <property name="text">
                <string>Enrolled Session:</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QComboBox" name="combo_student_courses"/>
             </item>
             <item>
              <widget class="QLabel" name="lbl_token_prompt">
               <property name="text">
                <string>Session Token / 6-Digit PIN:</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLineEdit" name="txt_qr_code">
               <property name="placeholderText">
                <string>Enter 6-digit PIN or paste QR token</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btn_submit_attendance">
               <property name="text">
                <string>Check In</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="lbl_checkin_status">
               <property name="text">
                <string>Ready for check-in</string>
               </property>
               <property name="alignment">
                <set>Qt::AlignCenter</set>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
          <!-- Excuse Request Box -->
          <item>
           <widget class="QGroupBox" name="grp_excuse">
            <property name="title">
             <string>Absence Excuse Submission</string>
            </property>
            <layout class="QVBoxLayout" name="excuseSubLayout">
             <item>
              <widget class="QLabel" name="lbl_excuse_course">
               <property name="text">
                <string>Impacted Course:</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QComboBox" name="combo_excuse_course"/>
             </item>
             <item>
              <widget class="QLabel" name="lbl_date_prompt">
               <property name="text">
                <string>Absence Date:</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QDateEdit" name="date_excuse">
               <property name="calendarPopup">
                <bool>true</bool>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="lbl_reason_prompt">
               <property name="text">
                <string>Reason / Classification:</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QTextEdit" name="txt_excuse_reason">
               <property name="placeholderText">
                <string>Enter medical, athletic, or personal explanation...</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btn_submit_excuse">
               <property name="text">
                <string>Submit Formal Excuse Slip</string>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
        </item>
