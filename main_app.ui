             <property name="text">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;h2 style=&quot;margin:0;&quot;&gt;Sign in to your Portal&lt;/h2&gt;&lt;p style=&quot;color:#88a0b0; font-size:11px;&quot;&gt;Select role or provide institutional credentials&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
